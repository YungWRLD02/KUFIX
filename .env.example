# KUFIX environment variables
# Copy this file to .env and fill in real values before running the app.
# Never commit or share the real .env file.

# Required: PostgreSQL connection string used by the application and Drizzle Kit.
# Local development example:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Production example (replace with your managed Postgres URL):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Recommended in production: HMAC secret used to sign session tokens.
# Generate one with: openssl rand -hex 32
# Falls back to DATABASE_URL if unset — acceptable locally, unsafe in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Paystack (optional). Leave unset for simulated instant deposits/withdrawals.
# Get a test key (sk_test_...) from https://dashboard.paystack.com/#/developer/apikeys
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Managed automatically by Next.js (do not set manually in production):
# NODE_ENV=production
